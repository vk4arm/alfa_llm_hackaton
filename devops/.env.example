# =========================================================================
# ALFA AI GATEWAY — ENVIRONMENT CONFIGURATION
# =========================================================================

# Gateway
GATEWAY_PORT=8000
GATEWAY_LOG_LEVEL=INFO

# Redis Ephemeral Session Vault & Cache
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
SESSION_TTL_SEC=300

# Vector Database (Qdrant)
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_SIMILARITY_THRESHOLD=0.95

# On-Prem vLLM Cluster Endpoints
VLLM_TIER1_URL=http://vllm-tier1:8000/v1
VLLM_TIER2_URL=http://vllm-tier2:8000/v1
VLLM_TIER3_URL=http://vllm-tier3:8000/v1

# Circuit Breaker Thresholds
CB_FAILURE_THRESHOLD_PCT=5.0
CB_LATENCY_P99_THRESHOLD_MS=2500.0
CB_KV_CACHE_THRESHOLD_PCT=95.0
CB_COOLDOWN_SEC=30.0

# Kafka SIEM WORM Audit
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_AUDIT_TOPIC=alfa.ai.gateway.audit.worm
